{
  "name": "cfb-forecast-log",
  "version": "0.1.0",
  "private": true,
  "description": "Logs college football win-probability forecasts next to Kalshi and Vegas prices, then scores them. No trading.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "ratings": "tsx src/jobs/ratings.ts",
    "snapshot:tuesday": "tsx src/jobs/snapshot.ts tuesday",
    "snapshot:report": "tsx src/jobs/snapshot.ts report",
    "snapshot:pregame": "tsx src/jobs/snapshot.ts pregame",
    "snapshot:manual": "tsx src/jobs/snapshot.ts manual",
    "resolve": "tsx src/jobs/resolve.ts",
    "report": "tsx src/jobs/report.ts",
    "tracker": "tsx src/jobs/tracker.ts",
    "news:extract": "tsx scripts/news.ts extract",
    "news:windows": "tsx scripts/news.ts windows",
    "news:import": "tsx scripts/news.ts import",
    "news:restamp": "tsx scripts/news.ts restamp",
    "news:gameref": "tsx scripts/news.ts gameref",
    "news:players": "tsx scripts/news.ts players",
    "news:availability": "tsx scripts/news.ts availability",
    "news:report": "tsx scripts/news.ts report",
    "v2:check": "tsx scripts/v2.ts check",
    "v2:backtest": "tsx scripts/v2.ts backtest",
    "v3:fit": "tsx scripts/v3.ts fit",
    "v3:check": "tsx scripts/v3.ts check",
    "v4:check": "tsx scripts/v4.ts",
    "v5:fit": "tsx scripts/v5.ts fit",
    "v5:check": "tsx scripts/v5.ts check",
    "fit": "tsx scripts/fit.ts",
    "export": "tsx scripts/export.ts",
    "scheduler": "tsx src/scheduler.ts",
    "db:init": "tsx -e \"require('./src/db').openDb(); console.log('ok')\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "better-sqlite3": "^12.4.1",
    "cheerio": "^1.1.2",
    "node-cron": "^4.2.1",
    "tsx": "^4.20.6",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "typescript": "^5.9.3"
  }
}
